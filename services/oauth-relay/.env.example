# Optional canonical public origin (recommended if using a custom domain, e.g. https://auth.socialforge.app)
# PUBLIC_ORIGIN=https://your-relay.vercel.app

# Configure ONLY the platforms you want to enable for One-Click Sign In.
# Unset platforms remain disabled and automatically fall back to BYOK in SocialForge.

# Pinterest (https://developers.pinterest.com/apps/)
# Callback URL: https://<your-domain>/api/oauth/callback/pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
# Optional: set to https://api-sandbox.pinterest.com while in Trial access
# PINTEREST_API_BASE=https://api.pinterest.com

# Meta — Facebook Pages & linked Instagram Professional accounts (https://developers.facebook.com/apps/)
# Callback URL: https://<your-domain>/api/oauth/callback/facebook
META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business Configuration ID
# META_CONFIG_ID=

# Direct Instagram Business Login (optional standalone Instagram app)
# Callback URL: https://<your-domain>/api/oauth/callback/instagram_login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Threads (https://developers.facebook.com/apps/ -> Threads use case)
# Callback URL: https://<your-domain>/api/oauth/callback/threads
THREADS_APP_ID=
THREADS_APP_SECRET=

# LinkedIn (https://www.linkedin.com/developers/apps)
# Callback URL: https://<your-domain>/api/oauth/callback/linkedin
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X / Twitter (https://developer.x.com/en/portal/dashboard) — PKCE (S256)
# Callback URL: https://<your-domain>/api/oauth/callback/x
X_CLIENT_ID=
# Optional for confidential web apps; leave blank for public native PKCE apps
X_CLIENT_SECRET=

# TikTok (https://developers.tiktok.com/apps/) — PKCE (S256)
# Callback URL: https://<your-domain>/api/oauth/callback/tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube / Google (https://console.cloud.google.com/apis/credentials) — PKCE (S256)
# Callback URL: https://<your-domain>/api/oauth/callback/youtube
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

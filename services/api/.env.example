# Names only. Put real values in services/api/.env (git-ignored) or your host's secret store.
# Generate keys with: openssl rand -base64 32

# Required
DATABASE_URL=
SESSION_SIGNING_KEY=
TOKEN_ENCRYPTION_KEY=

# Server
PORT=
HOST=
PUBLIC_BASE_URL=
APP_VERSION=
GIT_COMMIT=
LOG_LEVEL=

# Media storage: S3-compatible when S3_ENDPOINT is set, else a local folder (MEDIA_DIR)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_DIR=

# Development: a labeled mock Pinterest account in every workspace (1 to enable)
MOCK_PROVIDERS=
# Run the worker inside the API process (1 to enable; production runs src/worker.ts separately)
RUN_WORKER=

# Pinterest (OAuth app). PINTEREST_API_BASE=https://api-sandbox.pinterest.com for Trial access.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_API_BASE=

# Worker tuning
PUBLISH_RETRY_LIMIT=
PUBLISH_RETRY_DELAY_SECONDS=
PUBLISH_RETRY_MAX_DELAY_SECONDS=
WORKER_POLL_SECONDS=

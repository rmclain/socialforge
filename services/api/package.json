{
  "name": "socialforge-api",
  "version": "0.1.0",
  "description": "SocialForge publishing service: Fastify API and pg-boss worker",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "worker": "node --env-file-if-exists=.env src/worker.ts",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.ts",
    "token": "node --env-file-if-exists=.env scripts/token.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "dev:local": "node --env-file-if-exists=.env scripts/dev-local.ts"
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "license": "UNLICENSED"
}

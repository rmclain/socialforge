<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The background publisher. Registered by the app with SMAppService.agent
     when you turn on Settings > Publishing > "Publish while SocialForge is closed". -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.socialforge.app.publisher</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/SocialForge</string>
    <key>ProgramArguments</key>
    <array>
        <string>Contents/MacOS/SocialForge</string>
        <string>--publish-agent</string>
    </array>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>com.socialforge.app</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
